# Copy this file to .env and fill in your values. Never commit .env.

SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=your_user
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=ECOM_WH
SNOWFLAKE_DATABASE=ECOM_DB

# Option 1: password login
SNOWFLAKE_PASSWORD=your_password

# Option 2: key-pair login (recommended). Leave SNOWFLAKE_PASSWORD empty if you use this.
# SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/keys/rsa_key.p8
