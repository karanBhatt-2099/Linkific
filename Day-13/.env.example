# ---------- YOUR Postgres (the one pgAdmin is connected to) ----------
# host.docker.internal = your own computer, as seen from inside Docker
PG_HOST=host.docker.internal
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password_here
PG_DB=warehouse                    # database where the ETL data will be stored

# ---------- Airflow ----------
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=day13-change-me

# ---------- Apify ----------
APIFY_TOKEN=your_apify_token_here
