<mxfile host="app.diagrams.net"><diagram name="ETL Architecture" id="etl1"><mxGraphModel dx="1100" dy="600" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="520"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ETL Architecture: Postgres + API + CSV to Snowflake" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="orch" value="Orchestration: Airflow DAG in Docker (main.py for local runs)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="180" y="60" width="620" height="40" as="geometry"/></mxCell><mxCell id="pg" value="PostgreSQL&lt;br&gt;&lt;small&gt;customers, orders (pgAdmin)&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="20" y="125" width="130" height="80" as="geometry"/></mxCell><mxCell id="api" value="REST API&lt;br&gt;&lt;small&gt;products (paginated)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="20" y="235" width="130" height="70" as="geometry"/></mxCell><mxCell id="csv" value="CSV file&lt;br&gt;&lt;small&gt;order_items.csv&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="20" y="335" width="130" height="70" as="geometry"/></mxCell><mxCell id="ext" value="Extract&lt;br&gt;&lt;small&gt;DB · API · file&lt;br&gt;incremental by updated_at&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="180" y="235" width="140" height="70" as="geometry"/></mxCell><mxCell id="stg" value="Staging area&lt;br&gt;&lt;small&gt;local Parquet files&lt;/